{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Docker Up",
			"options": {
				"cwd": "${workspaceFolder}/docker/"
			},
			"type": "shell",
			"command": "powershell",
			"args": [
				"-ExecutionPolicy",
				"Bypass",
				"-File",
				"${workspaceFolder}/docker/DockerComposeUp.ps1",
				"linux"
			],
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": false,
				"panel": "shared"
			},
			"problemMatcher": []
		},
		{
			"label": "Docker Down",
			"options": {
				"cwd": "${workspaceFolder}/docker/"
			},
			"type": "shell",
			"command": "powershell",
			"args": [
				"-ExecutionPolicy",
				"Bypass",
				"-File",
				"${workspaceFolder}/docker/DockerComposeDown.ps1",
				"linux"
			],
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": false,
				"panel": "shared"
			},
			"problemMatcher": []
		},
		{
			"type": "dotnet",
			"task": "build",
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"problemMatcher": [],
			"label": "dotnet: build"
		}
	]
}